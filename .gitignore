# Local environment, credentials, caches and build products
.DS_Store
.venv/
__pycache__/
*.py[cod]
*.nbc
*.nbi
.pytest_cache/
*.egg-info/
/build/
/dist/
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
client_secret*.json
node_modules/
*.log
*.tmp

# Large final forcing stays local; its JSON source receipts remain discoverable.
/data/paper_study/climate/nasa_v2/daily/**/*.parquet
/data/paper_study/climate/nasa_v2/daily

# French historical weather archives stay local; keep URLs, hashes and metadata receipts.
/data/external_weather_validation_20261022/meteo_france/*.csv.gz
/data/external_weather_validation_20261022/meteo_france/*.partial
/data/external_weather_validation_20261022/meteo_france/station_metadata.geojson

# New simulation output and temporary work are outside the retained evidence.
/outputs/
/scratch/
**/annual_outputs/


# Locally regenerated paper runs
/data/reproductions/
