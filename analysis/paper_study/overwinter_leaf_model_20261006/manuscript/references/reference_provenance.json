    "ShawRoyle1993": {
      "merged_from": "analysis/paper_study/overwinter_leaf_model_20261006/literature/references.csl.json",
      "source_url": "https://doi.org/10.1111/j.1365-3059.1993.tb02674.x",
      "scope": "main",
      "primary_evidence": {
        "source_type": "Primary observational epidemics in11winter-wheat crops over4years; cv.Longbow.",
        "verified_locations": [
          "Publisher abstract; Plant Pathology42:882–899"
        ],
        "direct_findings": [
          "Upper two leaves suffered infection from lower crop layers near their emergence, followed by within-layer secondary cycles.",
          "Relative timing of inoculum arrival and leaf emergence mattered more than weather infection suitability alone.",
          "Early upper-leaf infection left more time for subsequent cycles before senescence."
        ],
        "supports": [
          "Leaf-stage-aware exposure gates and explicit linkage from earlier lower-leaf infections to later upper-leaf risk.",
          "Retained infection cohorts and phenology-specific epidemic opportunity."
        ],
        "does_not_establish": [
          "A stage below which any infection is impossible.",
          "Universal cycle counts or modern-cultivar coefficients."
