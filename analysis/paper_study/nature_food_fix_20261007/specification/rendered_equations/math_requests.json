[{"id": 0, "tex": "T_d", "display": false}, {"id": 1, "tex": "T_d^{\\max}", "display": false}, {"id": 2, "tex": "R_d", "display": false}, {"id": 3, "tex": "P_d", "display": false}, {"id": 4, "tex": "c_d", "display": false}, {"id": 5, "tex": "d", "display": false}, {"id": 6, "tex": "d", "display": false}, {"id": 7, "tex": "\\operatorname{clip}(x,a,b)=\\min\\{b,\\max(a,x)\\}", "display": false}, {"id": 8, "tex": "\\begin{aligned}&g_d=c_d\\begin{cases}\n\\operatorname{clip}(T_d,0,20),&T_d\\leq30,\\\\\n20-2(T_d-30),&30<T_d\\leq40,\n\\end{cases}\\\\\n&G_d=G_{d-1}+g_d.\\end{aligned}", "display": true, "label": "S1"}, {"id": 9, "tex": "\\phi", "display": false}, {"id": 10, "tex": "j_d", "display": false}, {"id": 11, "tex": "\\begin{aligned}&\\delta_d=0.4093\\sin\\{2\\pi(j_d-81)/365\\},\\\\\n&\\ell_d={24\\over\\pi}\\arccos\\!\\left[\\operatorname{clip}\\{-\\tan\\phi\\tan\\delta_d,-1,1\\}\\right],\\\\\n&p_d=\\operatorname{clip}\\{1-0.09(16-\\ell_d),0,1\\}.\\end{aligned}", "display": true, "label": "S2"}, {"id": 12, "tex": "\\begin{aligned}&b_d^P=c_d\\mathbf1(G_P^{\\rm on}\\leq G_{d-1}<G_P^{\\rm off}),\\\\\n&u_d=g_d\\{1-b_d^P+b_d^Pp_d\\},\\\\\n&U_d=U_{d-1}+u_d.\\end{aligned}", "display": true, "label": "S3"}, {"id": 13, "tex": "v(T)=\\begin{cases}\n0,&T\\leq-4\\ \\text{or}\\ T\\geq16,\\\\\n(T+4)/4,&-4<T<0,\\\\\n1,&0\\leq T\\leq10,\\\\\n(16-T)/6,&10<T<16.\n\\end{cases}", "display": true, "label": "S4"}, {"id": 14, "tex": "b_d^V=c_d\\mathbf1(U_{d-1}\\geq U_V^{\\rm on})", "display": false}, {"id": 15, "tex": "s_d^V=\\mathbf1(U_{d-1}<U_V^{\\rm off})", "display": false}, {"id": 16, "tex": "\\widetilde V_d=V_{d-1}+s_d^Vv(T_d)", "display": false}, {"id": 17, "tex": "\\begin{aligned}&V_d^*=\\begin{cases}\n\\max\\{0,V_{d-1}-0.5(T_d^{\\max}-30)\\},&\\widetilde V_d<10\\ \\text{and}\\ T_d^{\\max}>30,\\\\\n\\widetilde V_d,&\\text{otherwise},\n\\end{cases}\\\\\n&V_d=(1-b_d^V)V_{d-1}+b_d^VV_d^*,\\end{aligned}", "display": true, "label": "S5"}, {"id": 18, "tex": "\\begin{aligned}&f_d^V=\\beg