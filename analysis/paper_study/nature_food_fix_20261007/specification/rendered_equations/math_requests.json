mathbf1(a_{7,d}>0)\\{1-\\exp[-\\max(T_d,0)/300]\\}.\\end{aligned}", "display": true, "label": "S11"}, {"id": 43, "tex": "J_d=1", "display": false}, {"id": 44, "tex": "a_{i,d}", "display": false}, {"id": 45, "tex": "C_{10}", "display": false}, {"id": 46, "tex": "S_i", "display": false}, {"id": 47, "tex": "m", "display": false}, {"id": 48, "tex": "L_{i,1},\\ldots,L_{i,m}", "display": false}, {"id": 49, "tex": "N_i", "display": false}, {"id": 50, "tex": "I_i", "display": false}, {"id": 51, "tex": "D_i", "display": false}, {"id": 52, "tex": "S_i+\\sum_{r=1}^{m}L_{i,r}+N_i+I_i+D_i=1.", "display": true, "label": "S12"}, {"id": 53, "tex": "Q^u,Q^c", "display": false}, {"id": 54, "tex": "((1-f_0)Q_0,f_0Q_0)", "display": false}, {"id": 55, "tex": "Q_0=1", "display": false}, {"id": 56, "tex": "f_0=0.5", "display": false}, {"id": 57, "tex": "(1,0,\\ldots,0)", "display": false}, {"id": 58, "tex": "1-\\rho_{i,d}", "display": false}, {"id": 59, "tex": "S_i", "display": false}, {"id": 60, "tex": "n=\\lceil1/\\Delta t_{\\rm req}\\rceil", "display": false}, {"id": 61, "tex": "\\eta=1/n", "display": false}, {"id": 62, "tex": "\\Delta t_{\\rm req}=0.25", "display": false}, {"id": 63, "tex": "n=4", "display": false}, {"id": 64, "tex": "\\theta_d=\\max(T_d,0)/18", "display": false}, {"id": 65, "tex": "r_d=1-\\exp(-P_d/p_*)", "display": false}, {"id": 66, "tex": "p_*=2", "display": false}, {"id": 67, "tex": "\\begin{aligned}&Z_{i,d}={\\sum_{j:h_{j,d}=1}\\exp(-|i-j|/\\lambda)I_j a_{j,d}\\over\\sum_{j:h_{j,d}=1}a_{j,d}},\\\\\n&C_{i,d}={\\sum_{j:h_{j,d}=1,\\ |i-j|=1}I_j a_{j,d}\\over\\sum_{j:h_{j,d}=1}a_{j,d}},\\end{aligned}", "display": true, "label": "S13"}, {"id": 68, "tex": "\\lambda=2", "display": false}, {"id": 69, "tex": "\\begin{aligned}\nz_i^{\\rm local}&=\\alpha e_dQ^c\\{(1-\\omega)r_d\\exp[-(7-i)/\\lambda]+\\omega\\},\\\\\nz_i^{\\rm imported}&=\\alpha e_d M_d,\\\\\nz_i^{\\rm splash}&=\\beta e_dr_d Z_{i,d},\\\\\nz_i^{\\rm contact}&=\\beta e_d\\kappa(1-a_{i,d})C_{i,d}\\mathbf1(i\\ne7).\n\\end{aligned}", "display": true, "label": "S14"}, {"id": 70, "tex": "e_d", "display": false}, {"id": 71, "tex": "M_d", "display": false}, {"id": 72, "tex": "\\omega=0.1", "display": false}, {"id": 73, "tex": "\\kappa=0.2", "display": false}, {"id": 74, "tex": "\\alpha=0.001", "display": false}, {"id": 75, "tex": "\\beta=10", "display": false}, {"id": 76, "tex": "z_i=\\sum_pz_i^p", "display": false}, {"id": 77, "tex": "\\begin{aligned}&F_i=S_i\\{1-\\exp(-\\eta z_i)\\},\\\\\n&F_i^p=\\begin{cases}F_i z_i^p/z_i,&z_i>0,\\\\0,&z_i=0.\\end{cases}\\end{aligned}", "display": true, "label": "S15"}, {"id": 78, "tex": "\\begin{aligned}&q_L=1-\\exp(-\\eta m\\theta_d/\\tau_L),\\\\\n&q_N=1-\\exp(-\\eta\\theta_d/\\tau_N),\\\\\n&q_I=1-\\exp(-\\eta\\theta_d/\\tau_I).\\end{aligned}", "display": true, "label": "S16"}, {"id": 79, "tex": "\\begin{aligned}\nS_i'&=S_i-F_i,\\\\\nL_{i,1}'&=(1-q_L)L_{i,1}+F_i,\\\\\nL_{i,r}'&=(1-q_L)L_{i,r}+q_LL_{i,r-1},\\quad r=2,\\ldots,m,\\\\\nN_i'&=(1-q_N)N_i+q_LL_{i,m},\\\\\nI_i'&=(1-q_I)I_i+q_NN_i,\\\\\nD_i'&=D_i+q_II_i.\n\\end{aligned}", "display": true, "label": "S17"}, {"id": 80, "tex": "\\tau_L=20", "display": false}, {"id": 81, "tex": "\\tau_N=3", "display": false}, {"id": 82, "tex": "\\tau_I=21", "display": false}, {"id": 83, "tex": "m=3", "display": false}, {"id": 84, "tex": "\\tau_L", "display": false}, {"id": 85, "tex": "\\mu_d=\\theta_de_d/\\tau_M", "display": false}, {"id": 86, "tex": "\\nu_d=\\theta_d/\\tau_Q", "display": false}, {"id": 87, "tex": "\\tau_M=30", "display": false}, {"id": 88, "tex": "\\tau_Q=90", "display": false}, {"id": 89, "tex": "\\begin{aligned}&(Q^u)'=Q^u\\exp[-\\eta(\\mu_d+\\nu_d)],\\\\\n&(Q^c)'=\\exp(-\\eta\\nu_d)\\{Q^c+Q^u[1-\\exp(-\\eta\\mu_d)]\\}.\\end{aligned}", "display": true, "label": "S18"}, {"id": 90, "tex": "(Q^u+Q^c)'=(Q^u+Q^c)\\exp(-\\eta\\nu_d)", "display": false}, {"id": 91, "tex": "h=0,\\ldots,23", "display": false}, {"id": 92, "tex": "\\widehat T_{d,h}=T_d+\\max(T_d^{\\max}-T_d,0)\\cos\\{2\\pi(h+0.5)/24\\}.", "display": true, "label": "S19"}, {"id": 93, "tex": "s_{d,h}=\\exp\\{17.625\\widehat T_{d,h}/(243.04+\\widehat T_{d,h})\\}", "display": false}, {"id": 94, "tex": "v_d", "display": false}, {"id": 95, "tex": "[0,\\max_hs_{d,h}]", "display": false}, {"id": 96, "tex": "24^{-1}\\sum_h\\min(v_d/s_{d,h},1)=R_d/100", "display": false}, {"id": 97, "tex": "\\widehat R_{d,h}=100\\min(v_d/s_{d,h},1)", "display": false}, {"id": 98, "tex": "\\begin{aligned}&H_{d,h}=\\mathbf1(\\widehat R_{d,h}\\geq90-10^{-7}),\\\\\n&f_d^R=1-\\exp[-P_d/(24r_*)],\\end{aligned}", "display": true, "label": "S20"}, {"id": 99, "tex": "e_d={1\\over24}\\sum_{h=0}^{23}\\exp\\left[-{1\\over2}\\left({\\widehat T_{d,h}-18\\over8}\\right)^2\\right]\n\\{H_{d,h}+(1-H_{d,h})f_d^R\\}.", "display": true, "label": "S21"}, {"id": 100, "tex": "r_*=0.45", "display": false}, {"id": 101, "tex": "[0,1]", "display": false}, {"id": 102, "tex": "M_d=0.1", "display": false}, {"id": 103, "tex": "\\begin{aligned}&L_{i,d}^{\\rm total}=\\sum_rL_{i,r,d},\\\\\n&X_{i,d}=N_{i,d}+I_{i,d}+D_{i,d},\\\\\n&B_{i,d}^{\\rm affected}=L_{i,d}^{\\rm total}+X_{i,d}=1-S_{i,d}.\\end{aligned}", "display": true, "label": "S22"}, {"id": 104, "tex": "B_{i,d}^{\\rm affected}\\geq\\epsilon", "display": false}, {"id": 105, "tex": "X_{i,d}\\geq\\epsilon", "display": false}, {"id": 106, "tex": "\\epsilon=0.001", "display": false}, {"id": 107, "tex": "l", "display": false}, {"id": 108, "tex": "u", "display": false}, {"id": 109, "tex": "(l,u]", "display": false}, {"id": 110, "tex": "t", "display": false}, {"id": 111, "tex": "\\begin{aligned}&\\mathcal D(t;l,u)=\\mathbf1(l\\text{ finite})\\max(l+1-t,0)\\\\\n&+\\mathbf1(u\\text{ finite})\\max(t-u,0).\\end{aligned}", "display": true, "label": "S23"}, {"id": 112, "tex": "\\max(30,d_{\\rm end}+1-u)", "display": false}, {"id": 113, "tex": "[K\\,n_f(k)\\,n_\\ell(k,f)\\,n_r(k,f,\\ell)]^{-1}", "display": false}, {"id": 114, "tex": "K", "display": false}, {"id": 115, "tex": "n_f", "display": false}, {"id": 116, "tex": "n_\\ell", "display": false}, {"id": 117, "tex": "n_r", "display": false}, {"id": 118, "tex": "L_*", "display": false}, {"id": 119, "tex": "\\mathcal A_{i,d}=L_*a_{i,d}/3,\\quad i=0,1,2.", "display": true, "label": "S24"}, {"id": 120, "tex": "\\mathcal A", "display": false}, {"id": 121, "tex": "L_*=1", "display": false}, {"id": 122, "tex": "f_{i,d}=X_{i,d}", "display": false}, {"id": 123, "tex": "f_{i,d}=X_{i,d}\\mathbf1(\\tau_i^{\\rm symptom}\\text{ exists and }d\\geq\\tau_i^{\\rm symptom})", "display": false}, {"id": 124, "tex": "\\mathcal W=\\{d:\\tau_{65}\\leq d\\leq\\tau_{85}\\}", "display": false}, {"id": 125, "tex": "\\begin{aligned}&\\mathrm{HAD}_{3}^{\\rm ref}=\\sum_{d\\in\\mathcal W}\\sum_{i=0}^{2}\\mathcal A_{i,d}(1\\ \\mathrm d),\\\\\n&\\mathrm{HAD}_{3}^{\\rm lost}=\\sum_{d\\in\\mathcal W}\\sum_{i=0}^{2}\\mathcal A_{i,d}f_{i,d}(1\\ \\mathrm d),\\end{aligned}", "display": true, "label": "S25"}, {"id": 126, "tex": "\\begin{aligned}&\\mathrm{HAD}_{3}^{\\rm healthy}=\\mathrm{HAD}_{3}^{\\rm ref}-\\mathrm{HAD}_{3}^{\\rm lost},\\\\\n&\\Delta Y_b=b\\,\\mathrm{HAD}_{3}^{\\rm lost}.\\end{aligned}", "display": true, "label": "S26"}, {"id": 127, "tex": "\\mathrm{HAD}_{3}^{\\rm lost}/L_*", "display": false}, {"id": 128, "tex": "\\mathrm{HAD}_{3}^{\\rm lost}/\\mathrm{HAD}_{3}^{\\rm ref}", "display": false}, {"id": 129, "tex": "b=0.0141,0.0180,0.0207", "display": false}, {"id": 130, "tex": "L_*", "display": false}, {"id": 131, "tex": "\\Delta Y_b", "display": false}, {"id": 132, "tex": "-b(\\mathrm{HAD}_{3,\\rm future}^{\\rm lost}-\\mathrm{HAD}_{3,\\rm historical}^{\\rm lost})", "display": false}, {"id": 133, "tex": "L_*", "display": false}, {"id": 134, "tex": "\\tau_{31}", "display": false}, {"id": 135, "tex": "100\\Delta Y_b/Y_{\\rm ref}", "display": false}, {"id": 136, "tex": "Y_{\\rm ref}", "display": false}, {"id": 137, "tex": "W_h", "display": false}, {"id": 138, "tex": "h", "display": false}, {"id": 139, "tex": "n_h=4", "display": false}, {"id": 14